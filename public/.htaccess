# ----------------------------------------------------------------------
# | Gzip / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching (Cache-Control)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images (Long cache - 1 year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS / JS (1 year - Immutable if hashed, but safer 1 year here)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  
  # HTML (No caching or short cache for updates)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control headers for assets
  <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Security Headers (Bonus SEO/Trust points)
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ----------------------------------------------------------------------
# | Custom Error Pages (404 optimization)
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# | Clean URLs (Rewrite rules for extensionless URLs)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>
